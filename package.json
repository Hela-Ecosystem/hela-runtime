{
  "name": "hela-runtime",
  "version": "1.3.0",
  "license": "MIT",
  "description": "HeLa Runtime daemon: boots the 10 HeLa cells as supervised processes, multiplexes their tools behind one MCP endpoint, and hosts agents in-process via Needle.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hela-runtime": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node scripts/test.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
